# rtl433 service configuration
#
# Installed to /etc/rtl433/rtl433.env and read by both systemd services.
# Edit values here, then: sudo systemctl restart rtl433-scan rtl433-forward

# Logical name for this node (used only in scan startup output).
NODE_NAME=pi-node

# Fixed raw JSON file the scanner writes and the forwarder tails.
# Must match the path in /etc/logrotate.d/rtl433.
RTL433_RAW_FILE=/home/pi/rtl433_raw.json

# rtl_433 runtime/stderr log.
RUNTIME_LOG=/home/pi/rtl433_runtime.log

# Frequency hop interval, seconds.
HOP_SECONDS=180

# Remote collector to forward decoded JSON to.
FORWARD_HOST=192.168.1.100
FORWARD_PORT=9000

# Forwarder connection tuning.
CONNECT_TIMEOUT=5
RETRY_SECONDS=5
