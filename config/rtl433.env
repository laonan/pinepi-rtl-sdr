# rtl433 service configuration
#
# Installed to /etc/rtl433/rtl433.env and read by both systemd services.
# Edit values here, then: sudo systemctl restart rtl433-scan rtl433-forward

# Logical name for this node (used only in scan startup output).
NODE_NAME=pi-node

# Fixed raw JSON file the scanner writes and the forwarder tails.
# Must match the path in /etc/logrotate.d/rtl433.
RTL433_RAW_FILE=/home/pi/rtl433_raw.json

# rtl_433 runtime/stderr log.
RUNTIME_LOG=/home/pi/rtl433_runtime.log

# Frequency hop interval, seconds.
HOP_SECONDS=180

# Remote collector to forward decoded JSON to.
FORWARD_HOST=192.168.1.100
FORWARD_PORT=9000

# Forwarder connection tuning.
CONNECT_TIMEOUT=5
RETRY_SECONDS=5


# ============================================================
# Collector role (second Pi, no RTL-SDR dongle)
#
# Used only by rtl433-collect.service. Ignored by the sensor services.
# The collector LISTENS on FORWARD_PORT (above), so the sensor's
# FORWARD_HOST should point at this machine and both share FORWARD_PORT.
# ============================================================

# Address the collector binds to (0.0.0.0 = all interfaces).
LISTEN_HOST=0.0.0.0

# Rolling raw JSON file the collector appends the received stream to.
# Reset (rolled + deleted) after each daily snapshot.
COLLECTOR_RAW_FILE=/home/pi/rtl433_received.json

# Where daily heatmap PNG snapshots are written.
SNAPSHOT_DIR=/home/pi/rtl433_snapshots

# Daily delivery time (local), HH:MM. Snapshot covers the preceding 24h.
DELIVER_AT=20:30

# Heatmap window (hours) and how many past snapshots to keep on disk.
WINDOW_HOURS=24
KEEP_SNAPSHOTS=14

# Push channel: wecom | log  (log = dry-run, just logs instead of sending).
PUSH_CHANNEL=wecom

# WeCom (企业微信) group-bot webhook URL. Required when PUSH_CHANNEL=wecom.
# Looks like: https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxxxxxx
WECOM_WEBHOOK_URL=

# HTTP timeout (seconds) for the push request.
PUSH_TIMEOUT=10
