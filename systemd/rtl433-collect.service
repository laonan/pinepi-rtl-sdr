[Unit]
Description=rtl_433 collector (TCP receiver + daily heatmap snapshot + push)
After=network-online.target
Wants=network-online.target
# Never stop retrying, even after repeated fast failures.
StartLimitIntervalSec=0

[Service]
Type=simple
User=__USER__
EnvironmentFile=/etc/rtl433/rtl433.env
# Runs from the venv the installer creates under the install dir, so Pillow is
# available without touching the system Python.
ExecStart=__INSTALL_DIR__/venv/bin/python -m rtl433_collector run
WorkingDirectory=__INSTALL_DIR__
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
